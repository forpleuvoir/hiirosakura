{
  "schemaVersion": 1,
  "id": "hiirosakura",
  "version": "${version}",
  "name": "Hiiro Sakura",
  "description": "不知道",
  "authors": [
    "forpleuvoir"
  ],
  "contact": {
    "email": "695801070@qq.com",
    "homepage": "https://modrinth.com/mod/hiirosakura",
    "sources": "https://github.com/forpleuvoir/ibuki_gourd",
    "issues": "https://github.com/forpleuvoir/ibuki_gourd/issues"
  },
  "license": "MIT",
  "icon": "assets/hiirosakura/icon.png",
  "accessWidener": "hiirosakura.accesswidener",
  "environment": "client",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "moe.forpleuvoir.hiirosakura.HiiroSakura"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "moe.forpleuvoir.hiirosakura.HiiroSakuraClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "moe.forpleuvoir.hiirosakura.compat.modmenu.ModMenuImpl"
      }
    ]
  },
  "mixins": [
    "hiirosakura.mixins.json",
    {
      "config": "hiirosakura.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "hiirosakura.client.compat.iris.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric": ">=0.112.0",
    "minecraft": ">=1.21.4",
    "java": ">=21",
    "fabric-language-kotlin": ">=1.11.0+kotlin.2.0.0",
    "ibukigourd": ">=0.8.4"
  },
  "suggests": {
    "another-mod": "modmenu"
  },
  "custom": {
    "ibukigourd": {
      "package": [
        "moe.forpleuvoir.hiirosakura"
      ]
    }
  }
}
